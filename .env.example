# XLResale environment variables — KEYS ONLY, never real values.
# Copy to .env.local for local dev, and add the same names in
# Vercel → Project → Settings → Environment Variables for deploys.
#
# See CLAUDE.md §12. Which phase each one is needed for is noted below.

# --- Supabase (Phase 0) -----------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — used by the Stripe webhook to set listing_paid.
# Never expose this to the browser, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform (Phase 2: Places, Phase 4: map, Phase 5: routes) ---
# Browser key. Restrict by HTTP referrer in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional separate server key for Distance Matrix / Routes and Time Zone.
# Restrict by IP, or leave unrestricted but never ship it to the client.
GOOGLE_MAPS_SERVER_KEY=

# --- Stripe (Phase 3: the $5 listing fee) -----------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint you create in the Stripe dashboard. Used to verify
# the signature — an unverified webhook must never write listing_paid.
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare R2 (Phase 2: featured-item photos) --------------------------
# Item photos live in R2, not Supabase Storage (see schema-additions-seller.sql).
# These are S3-compatible credentials from R2 -> Manage R2 API Tokens, NOT a
# general-purpose Cloudflare API token — the S3 client cannot use one of those.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Where a stored photo_key is served from. An r2.dev URL is fine for dev but is
# rate-limited and Cloudflare says not to use it in production; a custom domain
# needs the zone in the same Cloudflare account.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# --- v2 (not used yet) ------------------------------------------------------
RESEND_API_KEY=
ANTHROPIC_API_KEY=
